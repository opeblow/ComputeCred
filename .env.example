# ---------------------------------------------------------------------------
# ComputeCred - environment configuration
# Copy to .env and fill in. Never commit real keys.
# The worker and API load this automatically from the repo root (repo/.env);
# env vars already set in your shell take precedence over the file.
# ---------------------------------------------------------------------------
#
# To point at a .env elsewhere, use node's --env-file flag directly, e.g.
#   node --env-file=/absolute/path/.env --import tsx src/server.ts

# --- Ethereum Sepolia (source chain; jobs are created & settled here) ---
# JobMarket.sol is deployed here. The job settlement asset is an ERC-20
# (6 decimals) that BUYERS pay when settling, so the market holds escrow and
# the operator withdraws it. Nothing flows to the vault from this chain.
SOURCE_CHAIN_RPC_URL="https://sepolia.drpc.org"

# --- Creditcoin CC3 Testnet (execution chain; the vault lives here) ---
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"

# Wallet that signs worker operations on CC3 (operator facility owner by default).
CREDITCOIN_WALLET_PRIVATE_KEY=""

# --- Attestcoin / USC ---
# Chain key for the source chain on Creditcoin. 1 == Ethereum (Sepolia).
SOURCE_CHAIN_KEY=1
# Proof builder (Attestcoin proof generation) service.
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
# Predeployed EvmV1Decoder library on CC3 Testnet (from the gluwa reference examples).
EVM_V1_DECODER_LIBRARY_ADDRESS="0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B"

# --- Contract addresses (filled in after deployment) ---
JOB_MARKET_CONTRACT_ADDRESS=""
COMPUTE_CRED_VAULT_CONTRACT_ADDRESS=""
TEST_USDC_CC3_CONTRACT_ADDRESS=""

# --- Worker (durable proof pipeline; sqlite state in WORKER_DB_PATH) ---
# Optional: separate wallet that signs + broadcasts proofs. Defaults to
# CREDITCOIN_WALLET_PRIVATE_KEY. The operator/relayer authorization model lets a
# scoped hot wallet submit while the operator wallet stays safer.
WORKER_SUBMITTER_PRIVATE_KEY=""
# Optional: operator (facility owner) address. Defaults to the address of
# CREDITCOIN_WALLET_PRIVATE_KEY. Set when the operator wallet differs.
WORKER_OPERATOR_ADDRESS=""
# Path of the durable sqlite store (jobs + checkpoint). Resume-safe across restarts.
# Relative paths resolve from the repo root. Default: <repo>/worker-state/computecred.sqlite
WORKER_DB_PATH="worker-state/computecred.sqlite"
# Bounded retries for proof-building and proof-submission steps.
WORKER_MAX_PROOF_RETRIES="4"
WORKER_MAX_SUBMIT_RETRIES="3"
# Blocks to wait after a proof broadcast before marking a settlement confirmed.
WORKER_CONFIRMATIONS="1"
# First source-chain block to scan for JobSettled events (set to JobMarket deploy block).
WORKER_START_BLOCK=""
# How often (ms) the worker polls for new JobSettled events and pending proofs.
WORKER_POLL_INTERVAL_MS="15000"

# --- Read-layer API (serves the web dashboard; read-only) ---
API_PORT="8787"
API_CORS_ORIGIN="http://localhost:5173"