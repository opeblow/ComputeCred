# ---------------------------------------------------------------------------
# ComputeCred monorepo — root .gitignore
# Tracks source; ignores dependencies, generated artifacts, secrets and logs.
# ---------------------------------------------------------------------------

# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment / secrets (never commit) ---
.env
.env.local
.env.*.local
!.env.example

# --- Hardhat / Solidity build outputs (regenerated by `npm run contracts:compile`) ---
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/coverage/
contracts/coverage.json

# --- Worker build output ---
worker/dist/

# --- Web build output ---
web/dist/

# --- Test coverage ---
coverage/
coverage.json

# --- Logs & OS clutter ---
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.userosscache
*.sln.docstates

# --- Misc ---
*.swp
*~
.nyc_output/
.tmp/

# --- Internal planning (not published) ---
BUIDL_CTC_2026_Fall_Strategy.md